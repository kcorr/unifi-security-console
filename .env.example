# Copy this file to .env and fill in your values. Everything here can also be done from the
# web UI (Settings), which is the easier route - the values below only seed the first start.

# ---- First environment (optional) -----------------------------------------------
# More environments (other consoles or sites) are added in Settings -> Environments.
# UniFi OS console (UDM, UDR, UCG, UX, Cloud Key Gen2+):  https://192.168.1.1
# UniFi OS Server:                                         https://your-host:11443
UNIFI_URL=
# UniFi Network -> Settings -> Control Plane -> Integrations -> Create API Key.
UNIFI_API_KEY=
# Site short name as it appears in the URL (/manage/<site>/...). Usually "default".
UNIFI_SITE=default
# Consoles ship with self-signed certificates; leave false unless yours is trusted.
UNIFI_VERIFY_TLS=false
# How much the console may change on that controller:
#   read-only     never changes anything (default)
#   test-network  only creates rules for a dedicated "SC-Test" network
#   full          may change rules and settings (always after a preview)
WRITE_MODE=read-only

# ---- App ------------------------------------------------------------------------
# The first visit to the dashboard creates the sign-in account (username and password). To create it at the first
# start instead - wise if other machines can reach the dashboard - set both here. They are used once, while no
# account exists; change the password later in Settings -> Account.
APP_USERNAME=
APP_PASSWORD=
# Host names the dashboard answers to besides localhost / 127.0.0.1, comma separated - needed when you
# open it by LAN address or a domain (e.g. "unifi-sec.lan,192.168.1.20"). Protects against DNS rebinding.
ALLOWED_HOSTS=
# Optional secret used to encrypt stored API keys and sign sessions. Without it random keys kept in the
# data volume are used. If you set it, keep it - changing it makes stored keys unreadable and signs everyone out.
APP_SECRET=
# Days of threat history kept locally (per environment).
THREAT_RETENTION_DAYS=30

# ---- IP intelligence (passive: investigated IPs are never contacted) ------------
# Regional internet registries (RDAP) for ownership / abuse contact.
INTEL_RDAP=true
# Tor Project exit-node list (downloaded as a whole; no IPs are sent).
INTEL_TOR_LIST=true
# Third-party lookups - off by default; check their terms before enabling.
# ip-api.com free tier is non-commercial only.
INTEL_IPAPI=false
INTEL_INTERNETDB=false
# Optional reputation sources with your own free keys.
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
