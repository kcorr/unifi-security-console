{
  "name": "unifi-security-console",
  "version": "0.1.0",
  "private": true,
  "description": "Security-focused dashboard for UniFi networks: threats, IP intelligence, firewall/segmentation analysis and one-click hardening.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "node --test --disable-warning=ExperimentalWarning \"server/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "mmdb-lib": "^3.0.3",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "world-atlas": "^2.0.2"
  }
}
